<?xml version="1.0" encoding="utf-8"?>
<!-- The single radius token (16dp) every card in Claudex uses. Never tuned per card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/claudex_card" />
    <stroke android:width="1dp" android:color="@color/claudex_card_line" />
    <corners android:radius="16dp" />
</shape>
