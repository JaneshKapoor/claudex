# Local development. On Zerops these come from the service env vars instead —
# never commit a filled-in copy of this file.

DATABASE_URL=postgresql://claudex:claudex@localhost:5432/claudex
REDIS_URL=redis://localhost:6379

# 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every stored provider token — everyone must re-pair.
CLAUDEX_ENCRYPTION_KEY=replace-me-with-64-hex-characters

PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Run the poller inside the API process instead of as a separate service.
# Handy locally; on Zerops the worker is its own service.
RUN_WORKER_IN_API=1
POLL_INTERVAL_MS=1500000

# Optional — S3-compatible object storage for CSV exports and QR codes.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Used to build pairing QR links.
# PUBLIC_BASE_URL=https://api-claudex.prg1.zerops.app
# DASHBOARD_URL=https://dashboard-claudex.prg1.zerops.app
